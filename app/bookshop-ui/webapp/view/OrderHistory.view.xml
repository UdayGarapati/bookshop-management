<mvc:View
    controllerName="bookshop.ui.controller.OrderHistory"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f">
    
    <f:DynamicPage id="orderHistoryPage" headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Customer Dashboard &amp; Orders"/>
                </f:heading>
                <f:actions>
                    <Button text="Back to Dashboard" press=".onNavBack" icon="sap-icon://nav-back"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        
        <f:content>
            <IconTabBar id="idIconTabBar" class="sapUiResponsiveContentPadding">
                <items>
                    <!-- Order History Tab -->
                    <IconTabFilter id="ordersTab" icon="sap-icon://receipt" text="Order History">
                        <Table 
                            items="{path: 'order>/Orders', parameters: {$expand: 'items'}}"
                            class="sapUiResponsiveMargin">
                            <columns>
                                <Column><Text text="Order Number"/></Column>
                                <Column><Text text="Status"/></Column>
                                <Column><Text text="Tracking Info"/></Column>
                                <Column hAlign="End"><Text text="Total Price"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <ObjectIdentifier title="{order>orderNumber}"/>
                                        <ObjectStatus text="{order>status}" state="{= ${order>status} === 'Delivered' ? 'Success' : 'Warning'}"/>
                                        <Button text="Track" press=".onOpenTrackingDialog" icon="sap-icon://shipping-status"/>
                                        <ObjectNumber number="{order>totalPrice}" unit="EUR"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <!-- Wishlist Tab -->
                    <IconTabFilter id="wishlistTab" icon="sap-icon://favorite" text="Wishlist">
                        <Table items="{path: 'order>/Wishlist'}">
                            <columns>
                                <Column><Text text="Book ID"/></Column>
                                <Column><Text text="User"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{order>book_ID}"/>
                                        <Text text="{order>userName}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <!-- Sales Tab (Special Offers / Discounted Items) -->
                    <IconTabFilter id="salesTab" icon="sap-icon://sales-order" text="Sales &amp; Specials">
                        <MessageStrip text="Check out our weekly clearance items marked down by 20%!" type="Information" showIcon="true" class="sapUiMediumMarginBottom"/>
                        <!-- Bind to filtered books or sales entity here -->
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </f:content>
    </f:DynamicPage>
</mvc:View>