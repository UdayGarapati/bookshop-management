<mvc:View
    controllerName="bookshop.ui.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">
    <f:DynamicPage id="dashboardPage" headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Bookshop Management Dashboard" level="H1"/>
                </f:heading>
                <f:actions>
                    <Button
                        text="Cart ({cart>/totalCount})"
                        icon="sap-icon://cart"
                        type="Emphasized"
                        press=".onOpenCartDialog"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox class="sapUiResponsiveMargin">
                <Title text="Bookshop Management &amp; Storefront" level="H3" class="sapUiMediumMarginBottom"/>

                <HBox wrap="Wrap" class="sapUiMediumMarginTop">
                    <GenericTile
                        header="Books Catalog"
                        subheader="Explore &amp; search catalog"
                        press=".onNavToCatalog"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <TileContent>
                            <ImageContent src="sap-icon://book"/>
                        </TileContent>
                    </GenericTile>

                    <GenericTile
                        header="Order History"
                        subheader="View submitted orders"
                        press=".onNavToOrders"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <TileContent>
                            <ImageContent src="sap-icon://sales-order"/>
                        </TileContent>
                    </GenericTile>

                    <GenericTile
                        header="My Wishlist"
                        subheader="Saved favorite books"
                        press=".onNavToWishlist"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <TileContent>
                            <ImageContent src="sap-icon://favorite"/>
                        </TileContent>
                    </GenericTile>

                    <GenericTile
                        header="Sales &amp; Specials"
                        subheader="Discounts &amp; clearance"
                        press=".onNavToSales"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <TileContent>
                            <ImageContent src="sap-icon://sales-quote"/>
                        </TileContent>
                    </GenericTile>
                </HBox>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>