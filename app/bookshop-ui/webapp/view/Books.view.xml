<mvc:View
    controllerName="bookshop.ui.controller.Books"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f">
    
    <f:DynamicPage id="booksPage" headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Books Catalog"/>
                </f:heading>
                <f:actions>
                    <Button text="Back to Dashboard" press=".onNavBack" icon="sap-icon://nav-back"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        
        <f:content>
            <VBox class="sapUiResponsiveContentPadding" width="100%">
                
                <!-- Search Toolbar -->
                <Toolbar class="sapUiMediumMarginBottom">
                    <content>
                        <ToolbarSpacer/>
                        <SearchField 
                            placeholder="Search books by title..." 
                            search=".onSearch" 
                            width="400px"/>
                    </content>
                </Toolbar>

                <!-- Books Table with OData V4 Binding Parameters -->
                <Table 
    id="booksTable"
    items="{
        path: '/Books',
        parameters: {
            $count: true,
            $$updateGroupId: 'auto'
        }
    }"
    class="sapUiResponsiveMargin"
    width="auto"
    inset="false">
    <columns>
        <Column width="35%"><Text text="Book Title"/></Column>
        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Description"/></Column>
        <Column hAlign="End" width="20%"><Text text="Price"/></Column>
    </columns>
    <items>
        <ColumnListItem type="Navigation" press=".onBookPress">
            <cells>
                <ObjectIdentifier title="{title}"/>
                <Text text="{descr}"/>
                <ObjectNumber number="{price}" unit="{currency}"/>
            </cells>
        </ColumnListItem>
    </items>
</Table>

            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>