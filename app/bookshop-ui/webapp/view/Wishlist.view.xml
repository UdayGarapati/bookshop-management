<mvc:View
    controllerName="bookshop.ui.controller.Wishlist"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f">
    <f:DynamicPage headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="My Wishlist"/>
                </f:heading>
                <f:actions>
                    <Button text="Dashboard" press=".onNavBack" icon="sap-icon://nav-back"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox class="sapUiResponsiveContentPadding" width="100%">
                <Table
                    id="wishlistTable"
                    items="{
                        path: 'order>/Wishlist',
                        parameters: {
                            $expand: 'book'
                        }
                    }"
                    class="sapUiResponsiveMargin"
                    width="auto">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Saved Favorite Books"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column><Text text="Book Title"/></Column>
                        <Column><Text text="Saved By User"/></Column>
                        <Column hAlign="End" width="10rem"><Text text="Price"/></Column>
                        <Column hAlign="End" width="18rem"><Text text="Actions"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <ObjectIdentifier title="{order>book/title}"/>
                                <Text text="{order>userName}"/>
                                <ObjectNumber
                                    number="{order>book/price}"
                                    unit="{= ${order>book/currency_code} || 'EUR' }"
                                    emphasized="true"/>
                                <HBox justifyContent="End" alignItems="Center" class="sapUiTinyGap">
                                    <Button
                                        text="Add to Cart"
                                        icon="sap-icon://cart"
                                        type="Default"
                                        press=".onAddToCart"/>
                                    <Button
                                        text="Place Order"
                                        icon="sap-icon://accept"
                                        type="Emphasized"
                                        press=".onPlaceOrder"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>