<mvc:View
    controllerName="bookshop.ui.controller.BookDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f">
    <f:DynamicPage id="bookDetailPage" headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{title}"/>
                </f:heading>
                <f:actions>
                    <Button text="Back to Catalog" press=".onNavBack" icon="sap-icon://nav-back"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <Panel headerText="Book Information" class="sapUiResponsiveMargin" width="auto">
                <VBox class="sapUiSmallMargin">
                    <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
                        <Title text="{title}" level="H2"/>
                        <HBox alignItems="Center">
                            <Label text="Order Quantity:" labelFor="qtyStepInput" class="sapUiSmallMarginEnd"/>
                            <StepInput
                                id="qtyStepInput"
                                value="{detailView>/quantity}"
                                min="1"
                                max="{= Number(${stock}) > 0 ? Number(${stock}) : 1 }"
                                enabled="{= Number(${stock}) > 0 }"
                                width="120px"
                                class="sapUiSmallMarginEnd"/>
                            <Button
                                text="Place Order"
                                type="Emphasized"
                                press=".onPlaceOrder"
                                enabled="{= Number(${stock}) > 0 }"/>
                        </HBox>
                    </HBox>

                    <ObjectStatus
                        text="{stock} in stock"
                        state="{= Number(${stock}) > 0 ? 'Success' : 'Error' }"
                        class="sapUiSmallMarginTopBottom"/>

                    <VBox class="sapUiSmallMarginTop">
                        <Label text="Description" design="Bold"/>
                        <Text text="{descr}"/>
                    </VBox>

                    <VBox class="sapUiSmallMarginTop">
                        <Label text="ISBN" design="Bold"/>
                        <Text text="{isbn}"/>
                    </VBox>

                    <VBox class="sapUiSmallMarginTop">
                        <Label text="Price" design="Bold"/>
                        <ObjectNumber number="{price}" unit="{= ${currency_code} || 'EUR' }"/>
                    </VBox>

                    <VBox class="sapUiSmallMarginTop">
                        <Label text="Expected Delivery Date" design="Bold"/>
                        <Text text="{detailView>/expectedDeliveryDate} (7 days from order date)"/>
                    </VBox>
                </VBox>
            </Panel>
        </f:content>
    </f:DynamicPage>
</mvc:View>